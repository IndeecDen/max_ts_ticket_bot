# Managed by max-ts-ticket-bot backup installer
[Unit]
Description=Verified backup of MAX ticket bot
After=max-ts-ticket-bot.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/max-ts-ticket-bot-backup
User=root
UMask=0077
TimeoutStartSec=15min
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/max-ts-ticket-bot /var/lib/max-ts-ticket-bot /run/lock
