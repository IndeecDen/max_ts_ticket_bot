# Copy to .env and fill in locally. Never paste tokens into logs.
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
WORK_CHAT_ID=
HTTP_TIMEOUT_SECONDS=15
TIMEZONE=Europe/Moscow
DATABASE_PATH=data/max_bot.db
LOG_LEVEL=INFO
# Optional additional trusted CA file (PEM). TLS verification stays enabled.
MAX_CA_BUNDLE=
# Local receiver, behind a reverse proxy with public HTTPS on port 443.
WEBHOOK_SECRET=
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
